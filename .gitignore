termux-*


# ── Backup Files ─────────────────────────────────────────────────
*.bak
*.backup
*.orig
*.rej
*.tmp
*.temp
*.old
*.swp
*~

# Auto-generated backups
*.auto
*.auto.*
*.before-*


# ── Security / Secrets (NEVER commit) ────────────────────────────
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
.gnupg/
.gpg/
secrets.*
*.secret
credentials.*
config.local.*


# ── Database Files ───────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal


# ── Archive Files (Generated) ────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
# But keep specific distributables
!release-*.zip
!release-*.tar.gz


# ── Binary Bloat (Avoid committing) ──────────────────────────────
# Already committed: BusyBox Free_64
# Ignore other binaries unless explicitly added
*.exe
*.dll
*.dylib
# *.so is already ignored above

# Exception: BusyBox binary (explicitly tracked)
!BusyBox*


# ── Node.js (if any JS tools added later) ────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity


# ── Rust (if any Rust tools added later) ─────────────────────────
target/
Cargo.lock
**/*.rs.bk


# ── Temporary Dev Files ──────────────────────────────────────────
todo.txt
TODO.local
notes.txt
scratch/
drafts/
sandbox/
playground/


# ── OS-specific Cache ────────────────────────────────────────────
.cache/
.cache-*/
*.cache


# ── Project-specific ─────────────────────────────────────────────
# Noyon local config
noyon.local.conf
noyon.conf
noyon.local.json

# Custom OUI lists (keep default vulnwsc.txt)
custom-oui.txt
my-vulnwsc.txt
personal-oui.db

# Debug dumps
debug/
debug_*.txt
debug_*.log
dump/
dumps/


# ═══════════════════════════════════════════════════════════════════
#  End of .gitignore
#  If you accidentally committed something here, use:
#     git rm --cached <file>
#     git commit -m "Remove mistakenly tracked file"
# ═══════════════════════════════════════════════════════════════════
